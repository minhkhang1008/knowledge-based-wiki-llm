RAG_TOP_K=5
RAG_DISTANCE_THRESHOLD=0.68
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_BATCH_SIZE=32
CHROMA_UPSERT_BATCH_SIZE=64
OCR_MAX_WORKERS=2
OCR_CACHE_ENABLED=true
OCR_CACHE_DIR=storage/ocr_cache
OCR_EMBEDDED_IMAGES=true
IMAGE_VISION_CAPTION_ENABLED=false
OLLAMA_VISION_MODEL=llama3.2-vision
VISION_CACHE_DIR=storage/vision_cache
OLLAMA_HOST=http://localhost:11434
DATABASE_URL=sqlite+aiosqlite:///./knowledge_base.db
SQL_ECHO=false
CHROMA_PERSIST_PATH=./chroma_db
EXTRACTED_DATA_DIR=storage/extracted_data
MAX_UPLOAD_SIZE_MB=25
ENABLE_LEGACY_OFFICE_FORMATS=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
